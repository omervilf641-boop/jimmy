# Dependencies — reinstalled with `npm install`, never committed (559MB).
node_modules/

# Build output, including the packaged installer.
dist/
build/

# The neural voice model: 63MB of binary, downloaded from huggingface.
voices/*.onnx
voices/*.wav

# Whatever Python leaves behind.
__pycache__/
*.py[cod]
.venv/

# Runtime state lives in %APPDATA%\Jarvis, but keep any stray local copies out.
notes.txt
traces.jsonl
facts.json
projects.json

# Secrets, in case any ever land here.
.env

# Scratch output from orb_stub.py
orb_out.txt
diagnose-report.txt
diagnose-window.png
