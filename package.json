{
  "name": "jarvis-desktop",
  "version": "2.0.0",
  "description": "Jarvis — a local-first personal assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.omer.jarvis",
    "productName": "Jarvis",
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "server.py",
        "to": "server.py"
      },
      {
        "from": "type_text.ps1",
        "to": "type_text.ps1"
      },
      {
        "from": "ui",
        "to": "ui"
      },
      {
        "from": "voices",
        "to": "voices",
        "filter": [
          "**/*.onnx",
          "**/*.onnx.json"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Jarvis"
    }
  }
}
